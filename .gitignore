# Dependencies (installed via npm install)
node_modules/

# Build output (regenerated by `npm run build`)
dist/

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Throwaway / ad-hoc verification scripts
check-*.cjs
check-*.js
*.local

# Coverage / test artifacts
coverage/
.nyc_output/
